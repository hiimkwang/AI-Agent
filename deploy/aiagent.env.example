# =====================================================================
# Bien moi truong cho AI-Agent. Chep thanh /etc/aiagent.env va chmod 600.
#
# KHONG commit file da dien gia tri that vao git.
# =====================================================================

# --------------------------------------------------- Bat buoc
DB_URL=jdbc:postgresql://localhost:5432/rag_db
DB_USERNAME=admin
DB_PASSWORD=
# Thieu khoa nay thi MOI request bi 401.
RAG_ADMIN_API_KEY=
RAG_USER_API_KEY=

# --------------------------------------------------- Nha cung cap LLM
# Can it nhat mot khoa. Xem rag.llm.default-provider trong application.properties.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# COHERE_API_KEY=

# --------------------------------------------------- Dung sau reverse proxy
# BAT BUOC khi co nginx/apache dung truoc. Thieu no thi redirect_uri sinh ra la
# http:// va Microsoft tra AADSTS50011 du cau hinh nginx da dung.
FORWARD_HEADERS=NATIVE
RAG_TRUST_PROXY=true

# --------------------------------------------------- Dang nhap Entra ID (tuy chon)
# ENTRA_ENABLED=true
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# Cua hau khoi dong - XOA sau khi da gan app role RagAdmin trong Entra.
# ENTRA_BOOTSTRAP_ADMINS=quangbd@bsc.com.vn

# --------------------------------------------------- Bot Teams (tuy chon)
# BOT_ENABLED=true
# BOT_APP_ID=
# BOT_APP_PASSWORD=
# BOT_APP_TYPE=SINGLE_TENANT
# BOT_TENANT_ID=
# Chi de thu nghiem khi chua map nhom Entra: '*' cho phep nguoi khong xac dinh duoc
# doc moi nhom tai lieu. XOA truoc khi co tai lieu han che.
# BOT_UNIDENTIFIED_DEPARTMENTS=*

# --------------------------------------------------- Nap tai lieu tu may chu
RAG_ALLOWED_ROOTS=/data/tai-lieu

# --------------------------------------------------- OCR cho PDF ban scan
# MOI TRANG la mot loi goi model - bat len roi nap ca kho la mot khoan chi phi that.
# RAG_OCR_ENABLED=true
# RAG_OCR_PROVIDER=OPENAI
# RAG_OCR_MODEL=gpt-4o-mini
# RAG_OCR_MAX_PAGES=60

# --------------------------------------------------- Quet virus (ClamAV)
# RAG_AV_ENABLED=true
# RAG_AV_HOST=127.0.0.1
# RAG_AV_PORT=3310

# --------------------------------------------------- Vong doi du lieu
# RAG_RETENTION_CONVERSATION_DAYS=180
# RAG_RETENTION_AUDIT_DAYS=730

# --------------------------------------------------- Quyen rieng tu
# Bat len thi CAU HOI cua nguoi dung nam trong file log - can nhac ky.
RAG_LOG_QUESTIONS=false
RAG_LOG_ANSWERS=false
