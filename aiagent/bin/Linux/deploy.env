# Install settings for AI-Agent. KEY=value only; single-quote values with spaces.
# Changing anything here requires rerunning install.sh - these values are baked
# into the systemd unit file.

SERVICE_NAME=aiagent
SERVICE_DESC='AI-Agent - Tro ly tra cuu tai lieu noi bo (RAG)'

APP_DIR=/app/aiagent
APP_JAR=AIAgent-0.2.0.jar
CONFIG_DIR=
LOG_DIR=

# Empty JDK_DIR = <APP_DIR>/lib/jdk* first, then java on PATH.
JDK_DIR=
REQUIRED_JAVA_MAJOR=21

# Fixed ceiling, not MaxRAMPercentage: 15 GiB total, but Drupal and the security
# agent already take ~5.4 GiB and Postgres needs ~1 GiB shared_buffers.
XMS=512m
XMX=3g

JAVA_OPTS='-XX:+UseG1GC -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Ho_Chi_Minh -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=./logs -Djava.security.egd=file:/dev/./urandom'

LOGGING_CONFIG=
SPRING_PROFILES_ACTIVE=

# Secrets loaded at runtime via systemd EnvironmentFile. install.sh fails if
# missing - without it the app starts with default credentials and 401s.
RUNTIME_ENV_FILE=/app/aiagent/config/aiagent.env

# Not root: the app opens user-uploaded files with POI/PDFBox. install.sh creates
# this account if it does not exist - no manual step.
SERVICE_USER=aiagent
SERVICE_GROUP=aiagent

RESTART_SEC=20
START_TIMEOUT_SEC=120

# Units to order after. Empty if Postgres runs on another host.
AFTER_UNITS='rag-postgres.service'

# /actuator/health is permitAll, so no API key needed for the probe.
# Must include SERVER_CONTEXT_PATH from config/aiagent.env.
HEALTH_URL=http://127.0.0.1:8080/rag/actuator/health

# Unauthenticated. One port per service on a shared host (vsd-gateway uses 1093).
JMX_ENABLED=false
JMX_PORT=1094
JMX_HOST=

UNINSTALL_REMOVE_USER=false
