# =====================================================================
# AI-Agent - THE configuration file. Nothing else needs editing to run.
#
#   cp aiagent.env.example aiagent.env && chmod 600 aiagent.env
#   vi aiagent.env
#   systemctl restart aiagent
#
# Read by two units, so one value configures both:
#   - aiagent.service   (the application)
#   - rag-postgres.service (the database container)
#
# systemd syntax, NOT shell: KEY=value only. No export, no $(cmd), no ${VAR},
# no spaces around '='. Quotes end up inside the value.
# Do not commit the filled-in file.
# =====================================================================

# --------------------------------------------------------- REQUIRED
# Used by the Postgres container to create the role, and by the app to connect.
POSTGRES_PASSWORD=

# Empty => every request returns 401. Generate with: openssl rand -hex 24
RAG_ADMIN_API_KEY=
RAG_USER_API_KEY=

# Covers embedding, chat, rerank and OCR - one key for all four.
OPENAI_API_KEY=

# --------------------------------------------------------- Database
# Must match the container: POSTGRES_DB / POSTGRES_USER in the quadlet.
DB_URL=jdbc:postgresql://127.0.0.1:5432/rag_db
DB_USERNAME=rag
DB_POOL_MAX=10

# --------------------------------------------------------- Web
SERVER_PORT=8080
# 0.0.0.0 = the internal web UI is reachable at http://10.21.170.55:8080.
# Set 127.0.0.1 once everything goes through the Apache proxy.
SERVER_ADDRESS=0.0.0.0
# NATIVE is required behind Apache: without it Spring builds an http://
# redirect_uri and Microsoft returns AADSTS50011.
FORWARD_HEADERS=NATIVE
# Only true when a reverse proxy really is in front, otherwise anyone can forge
# X-Forwarded-For and corrupt the audit trail.
RAG_TRUST_PROXY=true
# Prefix Apache mounts the app under. Must match the ProxyPass path in
# /etc/httpd/conf.d/chatbot.conf and the Entra Redirect URI. Empty = root.
SERVER_CONTEXT_PATH=/rag

# --------------------------------------------------------- Models
# CHANGING THE EMBEDDING MODEL OR WIDTH MEANS RECREATING THE SCHEMA AND
# RE-INGESTING EVERY DOCUMENT. Decide before the first start.
# The app refuses to start if these disagree with the database (SchemaValidator).
RAG_EMBEDDING_PROVIDER=OPENAI
RAG_EMBEDDING_DIM=1536
RAG_EMBEDDING_OPENAI_MODEL=text-embedding-3-small

# Safe to change at any time.
RAG_LLM_PROVIDER=OPENAI
RAG_LLM_MODEL=gpt-4o-mini
# Cheap model for rewrite, HyDE, rerank and eval scoring.
RAG_INTERNAL_PROVIDER=OPENAI
RAG_INTERNAL_MODEL=gpt-4o-mini
# LLM | COHERE | NONE
RAG_RERANK_PROVIDER=LLM

# Only needed if a provider above is switched.
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#COHERE_API_KEY=

# --------------------------------------------------------- Ingestion
# The only directory that /admin/ingest-folder may read. Empty blocks it.
# Kept inside the application directory so nothing is scattered on the server.
RAG_ALLOWED_ROOTS=/app/aiagent/work/tai-lieu

# --------------------------------------------------------- Privacy
# true puts user questions and answers into the log files.
RAG_LOG_QUESTIONS=false
RAG_LOG_ANSWERS=false

# --------------------------------------------------------- Entra sign-in
# Off by default; API keys keep working either way. See docs/ENTRA-SETUP.md.
# Enabled without tenant/client id => the app refuses to start, by design.
# Redirect URI: https://chatbot-uat.bsc.com.vn/rag/login/oauth2/code/entra
# (tien to /rag den tu SERVER_CONTEXT_PATH o tren - thieu no la AADSTS50011)
#ENTRA_ENABLED=true
#ENTRA_TENANT_ID=
#ENTRA_CLIENT_ID=
#ENTRA_CLIENT_SECRET=
# Group object ids whose members are ADMIN. Comma separated. Resolved through
# Graph, so it works on Entra ID Free where app roles cannot target groups.
#ENTRA_ADMIN_GROUPS=
# Bootstrap backdoor - remove once ENTRA_ADMIN_GROUPS is set.
#ENTRA_BOOTSTRAP_ADMINS=cuongtb@bsc.com.vn

# --------------------------------------------------------- Teams bot
# See docs/TEAMS-BOT-SETUP.md.
# Endpoint: https://chatbot-uat.bsc.com.vn/rag/api/messages
#BOT_ENABLED=true
#BOT_APP_ID=
#BOT_APP_PASSWORD=
#
# STOP. The three lines above are all a Multi Tenant bot needs - and Multi Tenant is
# the Azure default. Leave BOT_APP_TYPE unset unless the Azure Bot resource itself was
# created as Single Tenant (Azure portal -> the bot -> Configuration -> Type of App).
#
# Setting SINGLE_TENANT for a multi-tenant bot points token validation at the company
# tenant's signing keys, while Bot Framework signs with its own. The bot then receives
# every message and rejects all of them:
#   Bot: token khong hop le: ... Signed JWT rejected: ... no matching key(s) found
# From Teams this looks exactly like a network problem, so people go hunting upstream.
#BOT_APP_TYPE=SINGLE_TENANT
#BOT_TENANT_ID=
# Escape hatch for testing before Entra groups are mapped: '*' lets anyone the bot
# cannot identify read every collection. Remove it before real documents land.
#BOT_UNIDENTIFIED_DEPARTMENTS=*

# --------------------------------------------------------- OCR
# One vision-model call per page. Measure how many scanned PDFs there are first.
#RAG_OCR_ENABLED=true
#RAG_OCR_MAX_PAGES=60

# --------------------------------------------------------- Virus scanning
# fail-closed: if clamd is unreachable, ingestion is refused.
#RAG_AV_ENABLED=true
#RAG_AV_HOST=127.0.0.1
#RAG_AV_PORT=3310

# --------------------------------------------------------- Retention
#RAG_RETENTION_CONVERSATION_DAYS=180
#RAG_RETENTION_AUDIT_DAYS=730

# --------------------------------------------------------- Logging
#LOG_LEVEL=DEBUG

# --------------------------------------------------------- Rarely changed
# Defaults are correct for this deployment; listed so nothing is configured
# outside this file.
#RAG_ALLOW_ANONYMOUS=false     # true bypasses auth entirely - never in production
#RAG_AUDIT_ENABLED=true
#RAG_AUDIT_INCLUDE_READ=false
#RAG_TEAMS_ENABLED=false       # legacy outgoing webhook, superseded by BOT_ENABLED
